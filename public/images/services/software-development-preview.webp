<section class="contact-consultation-section">
   <div class="container-fluid">
      <div class="contact-consultation-wrapper">
         <div class="consultation-grid">
            <!-- Left Side: Contact Form -->
            <div class="consultation-form-container">
               <h2>Get A Free Consultation For Your Project</h2>
               <form method="post" id="contactForm" enctype="multipart/form-data">
                  <input id="Name" name="sName" type="text" value="" required="" minlength="3" class="contact-input" placeholder="John Doe">
                  <span id="spnFirstName" style="color:red;"></span>
                  <input id="Email" type="email" value="" name="sEmail" required="" class="contact-input" placeholder="Enter Email Id Here">
                  <span id="spnEmail" style="color:red;"></span>
                  <input id="ContactNum" type="tel" value="" name="sContactNum" required="" class="contact-input" placeholder="Phone Number">
                  <input type="hidden" id="dialCode" name="dialCode" value="">
                  <input type="hidden" id="fullPhone" name="fullPhone" value="">
                  <span id="spnPhone" style="color:red;"></span>
                  <input id="Subject" type="text" value="" name="sSubject" required="" class="contact-input" placeholder="Subject">
                  <span id="spnSubject" style="color:red;"></span>
                  <textarea id="Message" name="sMessage" required="" minlength="10" class="contact-textarea" cols="30" rows="5" placeholder="Message/Comment"></textarea>
                  <span id="spnMessage" style="color:red;"></span>
                  <div class="upload-container">
                     <div class="upload-area" id="uploadArea">
                        <input 
                           type="file" 
                           class="upload-input LoNotSensitive" 
                           id="attach_file"
                           name="attach_file"
                           onchange="updateFileName()"
