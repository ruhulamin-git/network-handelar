		$(".close-global-btn").click(function() {

			let cookieValues = document.cookie.split('; ').find(row => row.startsWith('popupShown=')) ?? "null";

			if (cookieValues === "null") {
				// Set the initial cookie with an expiration time of 45 minutes
				const initialExpirationTime = new Date(Date.now() + 45 * 60 * 1000);
				document.cookie = `popupShown=true; expires=${initialExpirationTime.toUTCString()}; path=/`;

				// Set a timeout to delete the cookie after 45 minutes
				setTimeout(function() {
					document.cookie = "popupShown=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;";
					console.log("Cookie deleted after 45 minutes.");
				}, 45 * 60 * 1000); // 45 minutes in milliseconds
			}
		});



		// global popup trigger and set cookie end

		$('#successQuote, #successContact').hide();

		//Refresh Captcha
		function refreshCaptcha() {
			var img = document.images['captcha_image'];
			img.src = img.src.substring(
				0, img.src.lastIndexOf("?")
			) + "?rand=" + Math.random() * 1000;
		}



		//recent-project-slider
