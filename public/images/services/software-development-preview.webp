<section class="b4g-services-section">
   <div class="container-fluid">
      <div class="b4g-content-wrapper">
         <div class="b4g-services-header">
            <h2 class="b4g-services-heading">Next Generation AI Solutions from a Leading AI Development Company</h2>
            <p class="b4g-services-subtext">Biz4Group combines advanced AI engineering with product development expertise to build next-generation AI systems including generative AI platforms, autonomous agents, machine learning solutions, enterprise automation systems and computer vision technologies.  </p>
         </div>
         <div class="b4g-services-body">
            <!-- LEFT: accordion list -->
            <div class="b4g-services-list">
               <a class="b4g-svc-item is--active" data-index="0" href="https://www.biz4group.com/ai-development-company">
                  <div class="b4g-svc-line"></div>
                  <div class="b4g-svc-inner">
                     <span class="b4g-svc-num">01</span>
                     <span class="b4g-svc-title">Custom AI Development</span>
                  </div>
                  <div class="b4g-svc-body">AI systems designed around your specific workflows, data, and business goals. Built to automate processes, surface insights, and solve real operational challenges.</div>
                  <span class="b4g-svc-arrow">
                     <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                        <path d="M5 12h14M12 5l7 7-7 7"/>
                     </svg>
                  </span>
               </a>
               <a class="b4g-svc-item" data-index="1" href="https://www.biz4group.com/generative-ai-development-company">
                  <div class="b4g-svc-line"></div>
                  <div class="b4g-svc-inner">
                     <span class="b4g-svc-num">02</span>
                     <span class="b4g-svc-title">Generative AI Applications</span>
                  </div>
                  <div class="b4g-svc-body">Generative AI applications powered by modern LLMs that create content, assist users, and enhance digital products. Ideal for building intelligent features that customers actually use.</div>
                  <span class="b4g-svc-arrow">
                     <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                        <path d="M5 12h14M12 5l7 7-7 7"/>
                     </svg>
                  </span>
               </a>
               <a class="b4g-svc-item" data-index="2" href="https://www.biz4group.com/agentic-ai-development-company">
                  <div class="b4g-svc-line"></div>
                  <div class="b4g-svc-inner">
                     <span class="b4g-svc-num">03</span>
                     <span class="b4g-svc-title">Agentic AI Development</span>
                  </div>
                  <div class="b4g-svc-body">Autonomous AI systems that can plan tasks, reason through decisions, and take action across software environments. A powerful way to automate complex workflows and multi-step processes.</div>
                  <span class="b4g-svc-arrow">
                     <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                        <path d="M5 12h14M12 5l7 7-7 7"/>
                     </svg>
                  </span>
               </a>
               <a class="b4g-svc-item" data-index="3" href="https://www.biz4group.com/chatbot-development-company">
                  <div class="b4g-svc-line"></div>
                  <div class="b4g-svc-inner">
                     <span class="b4g-svc-num">04</span>
                     <span class="b4g-svc-title">AI Chatbot Development</span>
                  </div>
                  <div class="b4g-svc-body">Conversational AI that handles customer questions, support requests, and user interactions instantly. Designed to improve response times while reducing the workload on support teams.</div>
                  <span class="b4g-svc-arrow">
                     <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                        <path d="M5 12h14M12 5l7 7-7 7"/>
                     </svg>
                  </span>
               </a>
               <a class="b4g-svc-item" data-index="4" href="https://www.biz4group.com/ai-product-development-services">
                  <div class="b4g-svc-line"></div>
                  <div class="b4g-svc-inner">
                     <span class="b4g-svc-num">05</span>
                     <span class="b4g-svc-title">AI SaaS Product Development</span>
                  </div>
                  <div class="b4g-svc-body">Scalable SaaS platforms built with AI at the core. Designed for businesses launching new AI products or adding intelligent capabilities to existing platforms.</div>
                  <span class="b4g-svc-arrow">
                     <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                        <path d="M5 12h14M12 5l7 7-7 7"/>
                     </svg>
                  </span>
               </a>
               <a class="b4g-svc-item" data-index="5" href="https://www.biz4group.com/ai-agent-development-company">
                  <div class="b4g-svc-line"></div>
                  <div class="b4g-svc-inner">
                     <span class="b4g-svc-num">06</span>
                     <span class="b4g-svc-title">AI Agent Development</span>
                  </div>
                  <div class="b4g-svc-body">AI agents that retrieve information, perform tasks, and interact with business systems. A practical solution for automating everyday digital operations.</div>
                  <span class="b4g-svc-arrow">
                     <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                        <path d="M5 12h14M12 5l7 7-7 7"/>
                     </svg>
                  </span>
               </a>
               <a class="b4g-svc-item" data-index="6" href="https://www.biz4group.com/ai-integration-services">
                  <div class="b4g-svc-line"></div>
                  <div class="b4g-svc-inner">
                     <span class="b4g-svc-num">07</span>
                     <span class="b4g-svc-title">AI Model Integration</span>
                  </div>
                  <div class="b4g-svc-body">Add machine learning models directly into your existing software and business platforms. Turn your applications into intelligent systems without rebuilding your technology stack.</div>
                  <span class="b4g-svc-arrow">
                     <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                        <path d="M5 12h14M12 5l7 7-7 7"/>
                     </svg>
                  </span>
               </a>
               <a class="b4g-svc-item" data-index="7" href="https://www.biz4group.com/ai-copilot-development-company">
                  <div class="b4g-svc-line"></div>
                  <div class="b4g-svc-inner">
                     <span class="b4g-svc-num">08</span>
                     <span class="b4g-svc-title">AI Copilot Development</span>
                  </div>
                  <div class="b4g-svc-body">AI copilots that assist employees with analysis, recommendations, and everyday tasks. Integrated into business tools to improve productivity and decision-making.</div>
                  <span class="b4g-svc-arrow">
                     <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                        <path d="M5 12h14M12 5l7 7-7 7"/>
                     </svg>
                  </span>
               </a>
               <a class="b4g-svc-item" data-index="8" href="https://www.biz4group.com/ai-product-development-services">
                  <div class="b4g-svc-line"></div>
                  <div class="b4g-svc-inner">
                     <span class="b4g-svc-num">09</span>
                     <span class="b4g-svc-title">AI Product Engineering</span>
                  </div>
                  <div class="b4g-svc-body">End-to-end engineering for AI-powered products, from system architecture to production deployment. Built to perform reliably at scale in real business environments.</div>
                  <span class="b4g-svc-arrow">
                     <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                        <path d="M5 12h14M12 5l7 7-7 7"/>
                     </svg>
                  </span>
               </a>
               <a class="b4g-svc-item" data-index="9" href="https://www.biz4group.com/ai-consulting-services">
                  <div class="b4g-svc-line"></div>
                  <div class="b4g-svc-inner">
                     <span class="b4g-svc-num">10</span>
                     <span class="b4g-svc-title">AI Consulting &amp; Strategy</span>
                  </div>
                  <div class="b4g-svc-body">Clear guidance on where AI can create the most value in your organization. Includes technology planning, solution architecture, and practical implementation roadmaps.</div>
                  <span class="b4g-svc-arrow">
                     <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                        <path d="M5 12h14M12 5l7 7-7 7"/>
                     </svg>
                  </span>
               </a>
               <a class="b4g-svc-item" data-index="10" href="https://www.biz4group.com/ai-automation-services">
                  <div class="b4g-svc-line"></div>
                  <div class="b4g-svc-inner">
                     <span class="b4g-svc-num">11</span>
                     <span class="b4g-svc-title">AI Automation Solutions</span>
                  </div>
                  <div class="b4g-svc-body">Intelligent automation systems that streamline operations and eliminate repetitive manual work. Designed to improve efficiency across teams and departments.</div>
                  <span class="b4g-svc-arrow">
                     <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                        <path d="M5 12h14M12 5l7 7-7 7"/>
                     </svg>
                  </span>
               </a>
               <a class="b4g-svc-item" data-index="11" href="https://www.biz4group.com/ai-app-development-company">
                  <div class="b4g-svc-line"></div>
                  <div class="b4g-svc-inner">
                     <span class="b4g-svc-num">12</span>
                     <span class="b4g-svc-title">AI Application Development</span>
                  </div>
                  <div class="b4g-svc-body">Web and mobile applications enhanced with AI models, automation, and data intelligence. Built to deliver smarter user experiences and stronger product capabilities.</div>
                  <span class="b4g-svc-arrow">
                     <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                        <path d="M5 12h14M12 5l7 7-7 7"/>
                     </svg>
                  </span>
               </a>
               <a class="b4g-svc-item" data-index="12" href="https://www.biz4group.com/enterprise-ai-solutions">
