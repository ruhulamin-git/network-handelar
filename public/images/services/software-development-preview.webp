<script src="https://cdn.jsdelivr.net/npm/intl-tel-input@23.0.11/build/js/intlTelInput.min.js"></script>
<script>
   let iti;
   
   // Initialize intl-tel-input
   function initPhoneInput() {
       const input = document.querySelector("#ContactNum");
       
       iti = window.intlTelInput(input, {
           initialCountry: 'us',
           separateDialCode: true,
           preferredCountries: ['us', 'gb', 'in', 'ca', 'au'],
           utilsScript: "https://cdn.jsdelivr.net/npm/intl-tel-input@23.0.11/build/js/utils.js"
       });
       
       // Update hidden fields on country change
       input.addEventListener('countrychange', function() {
           updateDialCode();
       });
       
       // Update hidden fields on input
       input.addEventListener('input', function() {
           updateDialCode();
       });
       
       // Initial update
       updateDialCode();
   }
   
   function updateDialCode() {
       const selectedCountryData = iti.getSelectedCountryData();
       const dialCodeValue = '+' + selectedCountryData.dialCode;
       const fullPhoneValue = iti.getNumber();
       
       document.getElementById('dialCode').value = dialCodeValue;
       document.getElementById('fullPhone').value = fullPhoneValue;
       
   }
   
   // Initialize on page load
   if (document.readyState === 'loading') {
       document.addEventListener('DOMContentLoaded', initPhoneInput);
   } else {
       initPhoneInput();
   }
</script>
<!-- intl-tel-input end -->
