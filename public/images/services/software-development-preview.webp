<section class="faq-ai-section">
   <div class="container-fluid">
      <div class="faq-ai-wrapper">
         <h2 class="faq-ai-title">FAQ</h2>
         <div class="faq-ai-accordion">
            <!-- FAQ Item 1 -->
            <div class="faq-ai-item">
               <button class="faq-ai-question">
                  <span class="faq-title">How does Biz4Group leverage AI in business and enterprise solutions? </span>
                  <span class="faq-btn-icon">
                     <svg class="faq-ai-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                        <path d="M12 5V19M5 12H19" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                     </svg>
                  </span>
               </button>
               <div class="faq-ai-answer">
                  <p>Biz4Group develops AI-powered systems that automate workflows, analyze business data, and improve decision-making. Our solutions include generative AI applications, AI agents, predictive analytics, and intelligent automation integrated into enterprise software and digital platforms. </p>
               </div>
            </div>
            <!-- FAQ Item 2 -->
            <div class="faq-ai-item">
               <button class="faq-ai-question">
                  <span class="faq-title">How experienced are you in integrating AI solutions with existing systems? </span>
                  <span class="faq-btn-icon">
                     <svg class="faq-ai-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                        <path d="M12 5V19M5 12H19" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                     </svg>
                  </span>
               </button>
               <div class="faq-ai-answer">
                  <p>With 1000+ projects delivered, our team has extensive experience integrating AI models into existing web platforms, enterprise systems, SaaS products, and business workflows. We ensure smooth integration using APIs, cloud infrastructure, and scalable architecture without disrupting current operations. </p>
               </div>
            </div>
            <!-- FAQ Item 3 -->
            <div class="faq-ai-item">
               <button class="faq-ai-question">
                  <span class="faq-title">What is your AI project management approach? </span>
                  <span class="faq-btn-icon">
                     <svg class="faq-ai-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                        <path d="M12 5V19M5 12H19" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                     </svg>
