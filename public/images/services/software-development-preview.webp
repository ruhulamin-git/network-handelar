<!-- <elevenlabs-convai agent-id="agent_2001kd7ec28vesa83n8rjsq2178s" class="scale-float"></elevenlabs-convai><script src="https://unpkg.com/@elevenlabs/convai-widget-embed" async type="text/javascript"></script> -->
<script>
	// Remove "Powered by ElevenAgents" branding
	function removeBranding() {
		const convaiWidget = document.querySelector('elevenlabs-convai');
		if (convaiWidget && convaiWidget.shadowRoot) {
			// Target shadow DOM elements
			const shadowElements = convaiWidget.shadowRoot.querySelectorAll('*');
			shadowElements.forEach(el => {
				if (el.textContent && el.textContent.includes('Powered by')) {
					el.style.display = 'none';
					el.remove();
				}
			});
		}

		// Target regular DOM elements
		const allElements = document.querySelectorAll('elevenlabs-convai *, elevenlabs-convai');
		allElements.forEach(el => {
			if (el.textContent && (el.textContent.includes('Powered by') || el.textContent.includes('ElevenAgents'))) {
				el.style.display = 'none';
			}
		});
	}

	// Run after widget loads
	setTimeout(removeBranding, 2000);
	setTimeout(removeBranding, 5000);
	setTimeout(removeBranding, 10000);

	// Observer to catch dynamically added content
	const observer = new MutationObserver(removeBranding);
	observer.observe(document.body, {
		childList: true,
		subtree: true
	});
</script>

