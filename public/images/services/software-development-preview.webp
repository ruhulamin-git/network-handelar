<script>
   // Phone validation handled by intl-tel-input
   
   // Function to update file name display after file selection
   function updateFileName() {
       var attach_file = document.getElementById("attach_file");
       var fileNameDisplay = document.getElementById("fileName");
       var uploadText = document.querySelector(".upload-text");
       var fileErrorMsg = document.getElementById("fileErrorMsg");
   
       // Clear the previous file names and cross icons
       fileNameDisplay.innerHTML = '';
       
       // Clear any previous error messages
       if (fileErrorMsg) {
           fileErrorMsg.style.display = "none";
       }
   
       if (attach_file.files.length > 0) {
           var fileNames = [];
           var fileSizeExceeded = false;
           
           // Loop through the selected files and prepare the file names with cross icon
           for (var i = 0; i < attach_file.files.length; i++) {
               var file = attach_file.files[i];
               
               // Check if file size exceeds 5MB (5 * 1024 * 1024 bytes)
               if (file.size > 5 * 1024 * 1024) {
                   fileSizeExceeded = true;
                   
                   // If no error message element exists, create one
                   if (!fileErrorMsg) {
                       fileErrorMsg = document.createElement('p');
                       fileErrorMsg.id = "fileErrorMsg";
                       fileErrorMsg.style.color = "red";
                       fileErrorMsg.style.marginTop = "5px";
                       fileErrorMsg.style.opacity = "1";
                       document.querySelector(".upload-container").appendChild(fileErrorMsg);
                   }
                   
                   // Show error message
                   fileErrorMsg.textContent = "Error: File size exceeds 5MB limit!";
                   fileErrorMsg.style.display = "block";
                   
                   // Reset the file input
                   attach_file.value = "";
                   fileNameDisplay.style.display = "none";
                   uploadText.style.display = "block";
                   return;
               }
               
               var fileNameWithIcon = document.createElement('div');
               fileNameWithIcon.classList.add('file-item');
               fileNameWithIcon.innerHTML = `
                   <span class="file-name-text">${file.name}</span>
                   <span class="remove-icon" onclick="removeFile(${i})">&times;</span>
               `;
               fileNameDisplay.appendChild(fileNameWithIcon);  // Append the file name with icon
           }
   
           // Display the file name container
           fileNameDisplay.style.display = "block";  
           uploadText.style.display = "none";  // Hide the upload text
           console.log(attach_file.files);
       } else {
           // If no files are selected, hide the file-name container
           fileNameDisplay.style.display = "none";
           uploadText.style.display = "block";  // Show the upload text again
       }
   }
   
   // Remove the file from the file input and update the display
   function removeFile(index) {
       var attach_file = document.getElementById("attach_file");
       var dt = new DataTransfer(); // Create a new DataTransfer object to manipulate file list
   
       // Loop through the existing files and add all files except the one to be removed
       for (var i = 0; i < attach_file.files.length; i++) {
           if (i !== index) {
               dt.items.add(attach_file.files[i]);  // Add all files except the one to be removed
           }
       }
   
       // Update the file input with the new file list
       attach_file.files = dt.files;
       updateFileName();  // Re-update the file name display
   }
   
   // To stop the function execution
   // clearTimeout(timeoutId);
   
   // jQuery document ready function for form validation and AJAX submission
   jQuery().ready(function() {
       jQuery("#contactForm").validate({
           submitHandler: function(form) {
               // Validate phone number
               if (!iti.isValidNumber()) {
                   alert("Please enter a valid phone number.");
                   document.getElementById('ContactNum').focus();
                   return false;
               }
               
               // Update full phone number before submission
               updateDialCode();
               
               var response = grecaptcha.getResponse();
   
               if (response.length === 0) {
                   alert("Invalid Captcha! Please try again later.");
                   return false;  // Prevent form submission
               }
               
               // Check if any file exceeds 5MB before submission
               var attach_file = document.getElementById("attach_file");
               for (var i = 0; i < attach_file.files.length; i++) {
                   if (attach_file.files[i].size > 5 * 1024 * 1024) {
                       alert("Error: File size exceeds 5MB limit! Please select a smaller file.");
                       return false;  // Prevent form submission
                   }
               }
   
               var formData = new FormData(jQuery("#contactForm")[0]); // FormData handles file uploads
   
               // Disable submit button and add loading spinner
               var submitBtn = jQuery("button[name='submitContactForm']");
               var originalContent = submitBtn.html();
               submitBtn.prop('disabled', true);
               submitBtn.html('<span>Submitting</span> <i class="fa fa-spinner fa-spin"></i>');
               submitBtn.css('cursor', 'not-allowed');
               submitBtn.css('background-color', '#fff');
               submitBtn.css('color', '#2A95FC');
   
               
               // Perform AJAX request to submit the form
               jQuery.ajax({
                   url: "/", // Ensure this points to the correct server URL
                   type: "POST",
                   data: formData,
                   processData: false,  // Prevent jQuery from transforming the data into a query string
                   contentType: false,  // Allow FormData to set the appropriate content type
                   success: function(html) {
                       var obj = jQuery.parseJSON(html);
                       if (obj.restype == "success") {
                           // Reset the form
                           jQuery("#contactForm")[0].reset();
                           jQuery("#fileName").text("No file selected"); // Reset the file name display
                           
                           // Redirect to the 'Thank You' page if the form is successfully submitted
                           window.location = "https://www.biz4group.com/thankyou";
                       } else {
                           // Display an error message if the submission fails
                           alert(obj.error);
                           // Re-enable the button if submission fails
                           submitBtn.prop('disabled', false);
                           submitBtn.html(originalContent);
                           submitBtn.css('cursor', 'pointer');
                           submitBtn.css('background-color', '#2A95FC');
                           submitBtn.css('color', '#fff');
                       }
                   },
                   error: function(xhr, status, error) {
                       // Show error message in case of failure
                       alert("An error occurred during the upload process: " + error);
                       // Re-enable the button if submission fails
                       submitBtn.prop('disabled', false);
                       submitBtn.html(originalContent);
                       submitBtn.css('cursor', 'pointer');
                       submitBtn.css('background-color', '#2A95FC');
                       submitBtn.css('color', '#fff');
                   }
               });
   
               return false;  // Prevent default form submission
           }
       });
   });
</script>

