<script>
   (function () {
       var items = document.querySelectorAll('.b4g-svc-item');
       var cards = document.querySelectorAll('.b4g-svc-card');
   
       function activate(index) {
           items.forEach(function (el) { el.classList.remove('is--active'); });
           cards.forEach(function (el) { el.classList.remove('is--active'); });
           if (items[index]) items[index].classList.add('is--active');
           var cardIndex = index % 5;
           if (cards[cardIndex]) cards[cardIndex].classList.add('is--active');
       }
   
       items.forEach(function (item) {
           item.addEventListener('click', function (e) {
               // Check if the click was on the arrow icon or its children
               var isArrowClick = e.target.closest('.b4g-svc-arrow');
               
               if (isArrowClick) {
                   // Allow the link to navigate
                   return;
               }
               
               // Otherwise, prevent default and activate the item
               e.preventDefault();
               activate(parseInt(item.getAttribute('data-index'), 10));
           });
       });
   }());
</script>
<!-- services section end -->
