<script>
	function phoneValidate(e) {
		// Remove non-numeric characters
		var numericOnly = e.value.replace(/\D/g, "");

		// Restrict to 10 digits
		if (numericOnly.length > 10) {
			numericOnly = numericOnly.substring(0, 10);
		}

		// Update the input value
		e.value = numericOnly;
	}



	//  var timeoutId = setTimeout(function() {
	//     $('#myModal').modal();
	// }, 30000);

	$(document).ready(function() {



		// global popup trigger and set cookie start
		// window.addEventListener("load", (event) => {
		// 	let cookieValuesload = document.cookie.split('; ').find(row => row.startsWith('popupShown='));
		// 	if (!cookieValuesload) {

		// 		if (window.location.href.indexOf('ai-development-company') === -1 && window.location.href.indexOf('generative-ai-development-company') === -1 && window.location.href.indexOf('chatbot-development-company') === -1 && window.location.href.indexOf('career') === -1) {
