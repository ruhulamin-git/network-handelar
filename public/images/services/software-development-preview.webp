<style>
   .featured-on-section {
      padding: 18px 0;
      border-top: 1px solid #e5e5e5;
      border-bottom: 1px solid #e5e5e5;
      background: #fff;
      margin-bottom: 40px;
   }
   .featured-on-wrapper {
      display: flex;
      align-items: center;
      gap: 0;
      flex-wrap: nowrap;
      max-width: 1690px;
      margin: 0 auto;
   }
   .featured-on-label {
      font-size: 26px;
      font-weight: 700;
      color: #111;
      white-space: nowrap;
      flex-shrink: 0;
      padding-right: 20px;
      margin-right: 4px;
      border-right: 1px solid #ddd;
      padding: 8px 15px;
   }
   .featured-logos {
      display: flex;
      align-items: center;
      justify-content: space-evenly;
      flex: 1;
      flex-wrap: wrap;
      gap: 8px 0;
   }
   .featured-logo-link {
      text-decoration: none;
      display: flex;
      align-items: center;
      justify-content: center;
      flex: 1 1 0;
      padding: 8px 12px;
      border-right: 1px solid #ebebeb;
      transition: opacity 0.2s;
   }
   .featured-logo-link:last-child {
      border-right: none;
   }
   .featured-logo-link:hover {
      opacity: 0.65;
   }
   .featured-logo-link img {
      height: 38px;
      width: auto;
      max-width: 130px;
      object-fit: contain;
      display: block;
   }
   @media screen and (max-width: 1199px) {
      .featured-logo-link img {
         height: 32px;
         max-width: 110px;
      }
      .featured-logo-link {
         padding: 8px 10px;
      }
   }
   @media screen and (max-width: 991px) {
      .featured-on-wrapper {
         flex-direction: column;
         gap: 14px;
      }
      .featured-on-label {
         border-right: none;
         border-bottom: 1px solid #ddd;
         padding: 0 0 10px 0;
         margin-right: 0;
         width: 100%;
         text-align: center;
         font-size: 20px;
      }
      .featured-logos {
         justify-content: center;
         width: 100%;
         gap: 10px 0;
      }
      .featured-logo-link {
         flex: 0 0 25%;
         padding: 10px 8px;
         border-right: none;
         border-bottom: none;
      }
      .featured-logo-link img {
         height: 30px;
         max-width: 100px;
      }
   }
   @media screen and (max-width: 767px) {
      .featured-on-label {
         font-size: 16px;
      }
      .featured-logos {
         gap: 8px 0;
      }
      .featured-logo-link {
         flex: 0 0 33.33%;
         padding: 8px 6px;
      }
      .featured-logo-link img {
         height: 24px;
         max-width: 85px;
      }
   }
   @media screen and (max-width: 480px) {
      .featured-logo-link {
         flex: 0 0 50%;
         padding: 10px 8px;
      }
      .featured-logo-link img {
         height: 22px;
         max-width: 100px;
      }
   }
</style>
