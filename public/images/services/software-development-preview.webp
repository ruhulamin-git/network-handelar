<!--Ai modal-->
<div id="ebookModal" class="modal fade ebook-modal" role="dialog">
	<div class="modal-dialog modal-lg">
		<!-- Modal content-->
		<div class="modal-content">
			<button type="button" class="modal-closer" data-dismiss="modal">
				<svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 40 40" fill="none">
					<g clip-path="url(#clip0_21_37)">
						<path d="M16.6667 16.6667L23.3334 23.3333M23.3334 16.6667L16.6667 23.3333" stroke="#333333" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
						<path d="M20 5C32 5 35 8 35 20C35 32 32 35 20 35C8 35 5 32 5 20C5 8 8 5 20 5Z" stroke="#333333" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
					</g>
					<defs>
						<clipPath id="clip0_21_37">
							<rect width="40" height="40" fill="white" />
						</clipPath>
					</defs>
				</svg>
			</button>
			<div class="modal-body">
				<div class="row">
					<div class="col-md-5 col-sm-12 col-xs-12">
						<div class="modal-image">
							<img src="https://d1fxfakb0fcon3.cloudfront.net/images/e-book-img.webp" alt="e-book" />
						</div>
					</div>
					<div class="col-md-7 col-sm-12 col-xs-12">
						<div class="ebook-form-box">
							<form id="send-ai-model-form" method="post">
								<div class="box-heading">
									<h2>Get the Exclusive MIT Technology Review Insights Report for Free</h2>
									<p>Gain insights from a global survey of 351 technology seniors from organizations earning more than $1 billion.</p>
								</div>
								<div class="box-mid">
									<div class="form-group">
										<input class="form-control" type="text" id="name" name="name" required placeholder="Full Name" />
										<div id="errors" style="display:none;"></div>
									</div>
									<div class="form-group">
										<input class="form-control" type="email" name="email" id="email" required placeholder="Enter your email">
										<div id="errorsOne" style="display:none;"></div>
									</div>
									<div class="form-group">
										<div class="country-code">
											<input class="country-code-input form-control" name="phone" type="number" id="phone" required placeholder="Phone Number">
											<input type="hidden" name="phoneCountryDialCode" value="+1">
											<span id="spnContactNum">+1</span>
										</div>
										<div id="errorsTwo" style="display:none;"></div>
									</div>
									<div class="form-group">
										<div id="contact_recaptcha2"></div>
									</div>
									<div class="action-btn">
										<input type="hidden" name="ajax_call" value="sendMailAIModel">
										<button type="submit" id="submit" class="submit-btn">Yes, Give me the free e-Book</button>
									</div>
								</div>
								<div class="box-bottom">
									<p class="action-link">This site is protected by reCAPTCHA and the Google <a href="https://www.biz4group.com/privacy-policy">Privacy Policy</a> and <a href="https://www.biz4group.com/terms-and-conditions">Terms of Service</a> apply.</p>
									<p class="brief">By filling in this form, you are signing up to receive our emails and can unsubscribe at any time. </p>
								</div>
							</form>
						</div>
					</div>

				</div>
			</div>
		</div>
	</div>
</div>
<!-- Modal end -->



