	.footer-section .footer-mid .footer-mid-detail .footer-mid-heading h2::after {
		content: "";
		width: 40px;
		height: 2px;
		background-color: #000;
		position: absolute;
		bottom: 0;
		left: 0px;
		margin-bottom: -5px;
