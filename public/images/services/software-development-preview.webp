<!-- AI Solutions Section Animation Script -->
<script>
   (function () {
       window.addEventListener("load", () => {
   
           gsap.registerPlugin(ScrollTrigger);
   
           const cards = gsap.utils.toArray('.ai-solutions-card');
   
           cards.forEach((card, index) => {
               gsap.fromTo(card,
                   {
                       y: 100,
                       opacity: 0
                   },
                   {
                       y: 0,
                       opacity: 1,
                       duration: 0.8,
                       delay: index * 1, // 1 second gap between each card
                       ease: "power3.out",
                       scrollTrigger: {
                           trigger: card,
                           start: "top 85%",
                           toggleActions: "play none none none", // no reverse, no replay
                           once: true // animate only once
                       }
                   }
               );
           });
   
       });
   })();
</script>
<!-- banner typewriter animation -->
<script>
(function () {
    var phrases = ['Decide', 'Execute', 'Scale'];
    var el = document.getElementById('banner-typed-text');
    if (!el) return;

    var phraseIndex  = 0;
    var charIndex    = 0;
    var isDeleting   = false;

    var TYPE_SPEED        = 90;   // ms per character while typing
    var DELETE_SPEED      = 50;   // ms per character while deleting (faster = snappier)
    var PAUSE_AFTER_TYPE  = 2200; // ms to hold the completed phrase
    var PAUSE_BEFORE_NEXT = 380;  // ms gap between delete-finish and next phrase

    function tick() {
        var phrase = phrases[phraseIndex];

        if (isDeleting) {
            charIndex--;
            el.textContent = phrase.substring(0, charIndex);
        } else {
            charIndex++;
            el.textContent = phrase.substring(0, charIndex);
        }

        // Fully typed — pause, then start deleting
        if (!isDeleting && charIndex === phrase.length) {
            setTimeout(function () { isDeleting = true; tick(); }, PAUSE_AFTER_TYPE);
            return;
        }

        // Fully deleted — advance phrase and pause before typing next
        if (isDeleting && charIndex === 0) {
            isDeleting   = false;
            phraseIndex  = (phraseIndex + 1) % phrases.length;
            setTimeout(tick, PAUSE_BEFORE_NEXT);
            return;
        }

        // Add slight natural variation to typing speed only
        var delay = isDeleting
            ? DELETE_SPEED
            : TYPE_SPEED + (Math.random() * 30 - 15);

        setTimeout(tick, delay);
    }

    tick();
})();
</script>
<!-- Solution Cards Tab Functionality -->
<script>
   $(document).ready(function() {
       // Handle solution card clicks
       $('.solution-card').on('click', function() {
           const tabId = $(this).data('tab');
           
           // Remove active class from all cards
           $('.solution-card').removeClass('active');
           
           // Add active class to clicked card
           $(this).addClass('active');
           
           // Hide all detail cards
           $('.business-detail-card').removeClass('active');
           
           // Show the corresponding detail card
           $('.business-detail-card[data-content="' + tabId + '"]').addClass('active');
       });
       
       // FAQ Accordion Functionality
       $('.faq-ai-question').on('click', function() {
           const $item = $(this).closest('.faq-ai-item');
           const isActive = $item.hasClass('active');
           
           // Close all items
           $('.faq-ai-item').removeClass('active');
           
           // If the clicked item wasn't active, open it
           if (!isActive) {
               $item.addClass('active');
           }
       });
   
       // View All Solutions Button Functionality
       let isExpanded = false;
       $('#viewAllSolutionsBtn').on('click', function() {
           const $btn = $(this);
           const $hiddenCards = $('.ai-solutions-card.hidden-card');
           
           if (!isExpanded) {
               $hiddenCards.addClass('show');
               $btn.html('Show Less <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 20 20" fill="none" style="transform: rotate(180deg); transition: transform 0.3s;"><path d="M5 10L10 15L15 10" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>');
               isExpanded = true;
           } else {
               $hiddenCards.removeClass('show');
               $btn.html('View All Solutions <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M5 10L10 15L15 10" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>');
               isExpanded = false;
               setTimeout(function() {
                   $('html, body').animate({
                       scrollTop: $('.ai-solutions-industries-section').offset().top - 100
                   }, 800, 'swing');
               }, 100);
           }
       });
   });
</script>
